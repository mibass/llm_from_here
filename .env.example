# Copy to ".env" in the repo root (ignored by git). Used by python-dotenv via ShowRunner and plugins.
# Preflight: uv run python scripts/preflight_env.py [--strict] [--skip-podbean] [--skip-supabase]

# --- Required for full production-style runs (matches scripts/preflight_env.py defaults) ---
OPENAI_API_KEY=
YT_API_KEY=
FREESOUND_API_KEY=
PODBEAN_CLIENT_ID=
PODBEAN_CLIENT_SECRET=
SUPASET_URL=
SUPASET_KEY=

# --- Optional overrides ---
# Chat model: plugins/gpt.py defaults to gpt-3.5-turbo if unset; CI/release use gpt-4o-mini
OPENAI_MODEL_NAME=gpt-4o-mini

# Show TTS (plugins/showTTS.py); defaults to tts-1-1106 if unset
OPENAI_TTS_MODEL_NAME=tts-1-1106

# Prefix for cache/db naming (src/llm_from_here/common.py); default dev if unset
LLMFH_ENV=dev

# Download-effects URLs (src/llm_from_here/sound/downloadEffects.py)
DE_TEMPLATE_URL=
DE_DOWNLOAD_URL=

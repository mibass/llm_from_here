# Copy to ".env" in the repo root (ignored by git). Loaded by ShowRunner, plugins, and scripts/preflight_env.py.
# Preflight: uv run python scripts/preflight_env.py [--strict] [--skip-podbean] [--skip-supabase]
# Supabase provisioning: docs/supabase.md — uv run python scripts/bootstrap_supabase.py

# --- Required for full production-style runs (matches scripts/preflight_env.py defaults) ---
OPENROUTER_API_KEY=
YT_API_KEY=
FREESOUND_API_KEY=
PODBEAN_CLIENT_ID=
PODBEAN_CLIENT_SECRET=

# Supabase runtime (canonical)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy aliases — optional if you use SUPABASE_* above
SUPASET_URL=
SUPASET_KEY=

# --- Bootstrap-only (local; do not add SUPABASE_ACCESS_TOKEN to GitHub Actions) ---
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_NAME=
# SUPABASE_ORG_ID=
# SUPABASE_REGION=us-east-1
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
# Overrides configs/*/bucket_name for supabaseBucketManager when set (e.g. llmfhv2)
# SUPABASE_STORAGE_BUCKET=llmfh

# --- OpenRouter chat + structured output ---
# Paid/default chat slug when LLMFH_OPENROUTER_FREE_MODE is off (DeepSeek chat on OpenRouter; slug maps to current flagship)
OPENROUTER_MODEL=deepseek/deepseek-chat
# Slow-path TTS via OpenRouter (OpenAI-compatible audio.speech); ignored when LLMFH_OPENROUTER_FREE_MODE=1 (uses gTTS)
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=alloy
# Background music via OpenRouter Lyria (intro/story cues); ignored when LLMFH_OPENROUTER_FREE_MODE=1 (YouTube fallback)
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview
# Lyria on/off (default off). When off, music_generator_openrouter uses YouTube fallback directly.
# LLMFH_LYRIA_ENABLED=1
# Lyria empty-stream retries before YouTube fallback (default 3 attempts, exponential backoff)
# LLMFH_LYRIA_MAX_ATTEMPTS=3
# LLMFH_LYRIA_RETRY_DELAYS_SEC=2,8,20
# LLMFH_LYRIA_RETRY_DELAY_SEC=2
# native = pydantic-ai NativeOutput where supported; tool = tool-calling output (required for openrouter/free and DeepSeek on OpenRouter)
LLMFH_STRUCTURED_OUTPUT_MODE=native
# Retry structured call with tool output if native fails (optional)
# LLMFH_STRUCTURED_OUTPUT_FALLBACK=1
# Zero-cost: chat → openrouter/free (ignores OPENROUTER_MODEL); slow TTS → gTTS. Optional alt slug:
# LLMFH_OPENROUTER_FREE_CHAT_MODEL=
# LLMFH_OPENROUTER_FREE_MODE=1
# Mirror run logs to stderr while debugging (log file is still under outputs/.../showRunner.log):
# LLMFH_SHOWRUNNER_LOG_STDOUT=1
# Base directory for showRunner runs (default: <repo>/outputs). Used by scripts/run_until_new_guests.py:
# LLMFH_SHOWRUNNER_OUTPUT_DIR=/path/to/outputs
# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://github.com/your/repo
# OPENROUTER_APP_NAME=llm-from-here

# Prefix for cache/db naming (src/llm_from_here/common.py); default dev if unset
LLMFH_ENV=dev

# Download-effects URLs (src/llm_from_here/sound/downloadEffects.py)
DE_TEMPLATE_URL=
DE_DOWNLOAD_URL=

# --- yt-dlp (production / GitHub Actions; src/llm_from_here/plugins/ytfetch.py) ---
# Without cookie tuning set below, download_audio tries built-in presets (chrome/android/tv/web TLS + player clients).
# Set YT_DLP_DISABLE_FALLBACK=1 to force a single vanilla attempt (debug).
# Manual iteration order when presets are disabled: YT_DLP_IMPERSONATE → YT_DLP_PLAYER_CLIENT → cookies secret.
# Netscape cookies.txt path (FAQ: https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp )
# YT_DLP_COOKIE_FILE=
# YT_DLP_PLAYER_CLIENT=tv,android,web
# Browser TLS fingerprint (needs curl-cffi in pyproject); examples: chrome-136, chrome-131:android-12
# YT_DLP_IMPERSONATE=chrome-136
# YT_DLP_COMPAT_OPTIONS=2025
# Full extractor_args merge (JSON object; overrides YT_DLP_PLAYER_CLIENT for overlapping keys)
# YT_DLP_EXTRACTOR_ARGS_JSON={"youtube":{"player_client":["tv"]}}
# YT_DLP_SOCKET_TIMEOUT=60
# Default socket timeout is 60s when unset (see ytfetch.DEFAULT_YT_DLP_SOCKET_TIMEOUT).
# YT_DLP_VERBOSE=1
# Optional only when not using YT_DLP_IMPERSONATE:
# YT_DLP_USER_AGENT=
# Explicit Deno binary for yt-dlp EJS (otherwise PATH or ~/.deno/bin/deno)
# YT_DLP_DENO=/Users/you/.deno/bin/deno
